{
  "name": "downloader-workspace",
  "private": true,
  "version": "0.10.8",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "version:check": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs --set",
    "dev": "pnpm --filter @downloader/desktop dev",
    "build": "pnpm --filter @downloader/desktop build && pnpm --filter @downloader/extension build",
    "test": "pnpm --filter @downloader/extension test && pnpm --filter @downloader/desktop test",
    "typecheck": "pnpm --filter @downloader/desktop typecheck && pnpm --filter @downloader/extension typecheck",
    "desktop": "pnpm --filter @downloader/desktop tauri",
    "extension": "pnpm --filter @downloader/extension build"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "prettier": "^3.9.10"
  }
}
